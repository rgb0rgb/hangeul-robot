# 런타임 산출물 — 절대 커밋하지 않는다
*.log
*.pid
*.jsonl
*Zone.Identifier
__pycache__/
*.pyc
.pytest_cache/
.venv/
nohup.out

# 운영자 데이터는 백업/복원 도구로 관리한다 (git 대상 아님)
data/instances/*/
!data/instances/.gitkeep

# 이 컴퓨터에서만 뜻이 있는 것 — 화면 상태·장치 임대·막는 상태
data/console_state.json
data/leases/
# 실행기(tools/launcher.py)의 pid·보고·기록 — 그 컴퓨터에서 무엇이 떴었는지
data/run/
# 정지·단선 래치는 **그 로봇 앞에 선 사람의 상태**다. 출하물에 넣지 않는다.
data/safety_state_*.json
# 주행거리계도 그 로봇 것이다. 남의 이력을 물려받으면 정비 주기가 틀어진다.
data/usage_*.json

# 허깅페이스에 올릴 묶음은 만들어 쓰는 것이다
build/

# 대용량
*.zip
*.tar.gz
models/

# 등록된 로봇은 그 사람의 것이다 — 출하물에 넣지 않는다.
# 화면의 "로봇 추가"로 만들거나 아래 예시 파일을 복사해 쓴다.
install/robots/*.json
!install/robots/*.example.json
